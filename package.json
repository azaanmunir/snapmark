{
  "name": "snapmark",
  "productName": "SnapMark",
  "version": "0.1.0",
  "description": "Lightshot-style screenshot + annotation tool for designers (macOS & Windows)",
  "main": "src/main/main.js",
  "author": "Azaan Ali",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "check": "for f in src/main/*.js src/renderer/*.js scripts/*.js; do node --check \"$f\" || exit 1; done && echo OK",
    "dist:mac": "bash scripts/build.sh mac",
    "dist:win": "bash scripts/build.sh win",
    "test": "electron scripts/smoke-test.js",
    "update:mac": "bash scripts/build.sh update"
  },
  "build": {
    "appId": "com.azaan.snapmark",
    "productName": "SnapMark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
