{
  "name": "snapmark",
  "productName": "SnapMark",
  "version": "0.1.0",
  "description": "Fast, private screenshot and markup tool for designers, for macOS and Windows",
  "keywords": [
    "screenshot",
    "screen-capture",
    "annotation",
    "markup",
    "designer",
    "electron",
    "macos",
    "windows",
    "lightshot-alternative"
  ],
  "homepage": "https://github.com/azaanmunir/snapmark#readme",
  "bugs": {
    "url": "https://github.com/azaanmunir/snapmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azaanmunir/snapmark.git"
  },
  "main": "src/main/main.js",
  "author": "Azaan Ali",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "check": "for f in src/main/*.js src/renderer/*.js scripts/*.js; do node --check \"$f\" || exit 1; done && echo OK",
    "dist:mac": "bash scripts/build.sh mac",
    "dist:win": "bash scripts/build.sh win",
    "test": "electron scripts/smoke-test.js",
    "update:mac": "bash scripts/build.sh update",
    "test:clipboard": "electron scripts/clipboard-test.js"
  },
  "build": {
    "appId": "com.azaan.snapmark",
    "productName": "SnapMark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
